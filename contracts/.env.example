# Foundry deploy + verify configuration. Copy to .env and fill in for testnet/mainnet.
# For local anvil work, none of these need to be set.

# RPC for Base Sepolia (or your fork)
RPC_URL=https://sepolia.base.org

# Deployer EOA private key. NEVER commit a real key — .env is gitignored.
DEPLOYER_PRIVATE_KEY=

# Basescan API key for `forge verify-contract`
BASESCAN_API_KEY=
